{
  // Type checking of the browser's TypeScript: the viewer (src/viewer/src,
  // bundled into latex-viewer.js), the companion package (src/companion,
  // bundled into companion.js) and the inspector (src/inspector/src, built
  // into its scripts), and the website's own script (website/browser).
  // esbuild builds; this only checks. All of it is TypeScript: no JavaScript
  // is read.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/viewer/src/**/*", "src/companion/src/**/*", "src/inspector/src/**/*", "website/browser/**/*"]
}
