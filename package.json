{
  "name": "reflowtex",
  "private": true,
  "description": "Reflow TeX: LaTeX typeset by LuaTeX, re-broken in the browser. The build pipeline (src/pipeline, TypeScript run directly by Node).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.browser.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:web": "playwright test -c tests/web"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "esbuild": "0.28.2",
    "harfbuzzjs": "^1.6.2",
    "htm": "3.1.1",
    "mupdf": "1.28.1",
    "opentype.js": "^2.0.0",
    "preact": "10.29.8",
    "protobufjs": "^8.8.0",
    "speech-rule-engine": "^4.1.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^26.6.3",
    "pdf-lib": "^1.17.1",
    "playwright": "1.58.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
