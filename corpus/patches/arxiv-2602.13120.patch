# The paper's own loop defines \fa .. \fz as \mathfrak letters with \cs_new and already skips \fi.
# lipics-v2021 loads fontawesome5, which defines \fa, so \cs_new stops with an error. The paper uses neither \fa
# nor any fontawesome icon, so the loop now skips 'a' as it skips 'i'; nothing in the paper changes.
# Also: the paper was written for pdfLaTeX: UTF-8 text in an 8-bit font encoding; characters replaced by LaTeX's own definitions
# (t1enc.dfu, what pdfLaTeX's inputenc gives them), braced where the definition is a command. Under LuaLaTeX
# these characters reached the 8-bit font unchanged and were lost ("Missing character" in the log).
# Replaced outside comments, verbatim, listings and URLs:
#   ł (U+0142) -> \l: 3 in the source (11 missing-character lines in the log before)
#   ń (U+0144) -> \'n: 1 in the source (4 missing-character lines in the log before)
#   – (U+2013) -> \textendash: 1 in the source (4 missing-character lines in the log before)
# After the change the plain LuaLaTeX build reports none of these characters missing, and its page count is unchanged.
# The source is CC BY 4.0, which allows modified copies with the change indicated: this file is that indication.
--- a/bibliography.bib
+++ b/bibliography.bib
@@ -183,7 +183,7 @@
     abstract = {Motivated by formal models recently proposed in the context of XML, we study automata and logics on strings over infinite alphabets. These are conservative extensions of classical automata and logics defining the regular languages on finite alphabets. Specifically, we consider register and pebble automata, and extensions of first-order logic and monadic second-order logic. For each type of automaton we consider one-way and two-way variants, as well as deterministic, nondeterministic, and alternating control. We investigate the expressiveness and complexity of the automata and their connection to the logics, as well as standard decision problems. Some of our results answer open questions of Kaminski and Francez on register automata.},
     journal = {ACM Trans. Comput. Logic},
     month = jul,
-    pages = {403–435},
+    pages = {403{\textendash}435},
     numpages = {33},
     keywords = {registers, pebbles, monadic second-order logic, infinite alphabets, first-order logic, expressiveness, XML, Automata}
 }
@@ -230,7 +230,7 @@
 
